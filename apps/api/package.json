{
  "name": "@routergo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "db:migrate": "tsx --env-file=../.env --env-file=.env --env-file=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=../.env --env-file=.env --env-file=../../.env src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/sse": "^0.4.0",
    "@routergo/shared": "workspace:*",
    "bullmq": "^6.0.9",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.1",
    "nanoid": "^5.0.9",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.0",
    "vitest": "^1.6.0"
  }
}
